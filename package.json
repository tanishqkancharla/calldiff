{
  "name": "calldiff",
  "version": "0.4.0",
  "description": "Diff call stacks across git commits for agentic code review (22 languages)",
  "type": "module",
  "bin": {
    "calldiff": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanishqkancharla/calldiff.git"
  },
  "bugs": {
    "url": "https://github.com/tanishqkancharla/calldiff/issues"
  },
  "homepage": "https://github.com/tanishqkancharla/calldiff#readme",
  "keywords": [
    "callgraph",
    "diff",
    "callstack",
    "tree-sitter",
    "git",
    "multi-language",
    "typescript",
    "python",
    "rust",
    "go"
  ],
  "author": "Tanishq Kancharla",
  "license": "MIT",
  "dependencies": {
    "picocolors": "^1.1.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
